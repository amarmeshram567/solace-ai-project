# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# Neon: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/solace_ai

# Generate each with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-64-plus-random-characters-access
JWT_REFRESH_SECRET=replace-with-64-plus-random-characters-refresh

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated origins allowed by CORS (native apps do not send Origin; this matters for web tools only)
CORS_ORIGINS=http://localhost:8081

# AI: "gemini" or "disabled". Keep the API key on the server; never put it in the mobile app.
AI_PROVIDER=gemini
GEMINI_API_KEY=replace-with-your-google-ai-studio-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# Password reset delivery: "console" prints codes to the server log (development only).
# "disabled" sends nothing. Production refuses to start with "console".
EMAIL_DELIVERY=console

# Reminders: the scheduler creates inbox items every minute. Turn it on for one instance only.
JOBS_ENABLED=false
# "expo" sends push notifications through Expo; "disabled" keeps reminders in the in-app inbox.
PUSH_DELIVERY=disabled
