// Solace AI — PostgreSQL schema.
// Conventions: UUID primary keys, created/updated timestamps, snake_case tables via @@map,
// cascading deletes from users so account deletion removes all personal data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Mood {
  HAPPY
  CALM
  GRATEFUL
  NEUTRAL
  ANXIOUS
  SAD
  STRESSED
  OVERWHELMED
}

enum AssessmentKind {
  MOOD_VIBES
  ANXIETY_CHECK
  SELF_LOVE_METER
}

enum ActivityCategory {
  MINDFULNESS
  SELF_LOVE
  STRESS_RELIEF
  BETTER_SLEEP
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum XpReason {
  MOOD_CHECKIN
  BREATHING_SESSION
  WELLNESS_ACTIVITY
  ASSESSMENT_COMPLETED
  DAILY_REFLECTION
  JOURNALING
}

enum NotificationType {
  DAILY_MOOD_CHECKIN
  DAILY_AFFIRMATION
  BREATHING_REMINDER
  SELF_CARE_REMINDER
  CUSTOM_REMINDER
}

// ---------- Identity & profile ----------

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(254)
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  profile       UserProfile?
  preferences   UserPreference?
  refreshTokens RefreshToken[]
  resetTokens   PasswordResetToken[]
  moods         MoodEntry[]
  assessmentResults AssessmentResult[]
  activityCompletions ActivityCompletion[]
  userAffirmations UserAffirmation[]
  breathingSessions BreathingSession[]
  conversations AiConversation[]
  memories      UserAiMemory[]
  xpTransactions XpTransaction[]
  level         UserLevel?
  streak        UserStreak?
  notifications Notification[]
  notificationPreferences NotificationPreference[]
  pushTokens    PushToken[]
  savedResources UserSavedResource[]

  @@map("users")
}

model UserProfile {
  userId      String   @id @map("user_id") @db.Uuid
  displayName String   @map("display_name") @db.VarChar(60)
  birthYear   Int?     @map("birth_year")
  avatarKey   String?  @map("avatar_key") @db.VarChar(64)
  avatarData     Bytes?  @map("avatar_data")
  avatarMimeType String? @map("avatar_mime_type") @db.VarChar(32)
  timezone    String   @default("Asia/Kolkata") @db.VarChar(64)
  // Set once the user completes profile setup. Null means setup is still required.
  profileCompletedAt DateTime? @map("profile_completed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserPreference {
  userId             String   @id @map("user_id") @db.Uuid
  aiPersonalization  Boolean  @default(false) @map("ai_personalization")
  aiMemoryConsent    Boolean  @default(false) @map("ai_memory_consent")
  reducedMotion      Boolean  @default(false) @map("reduced_motion")
  ambientSoundOn     Boolean  @default(false) @map("ambient_sound_on")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// Added beyond the 25 listed entities: required for the refresh-token strategy.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// Added beyond the 25 listed entities: needed for Phase 2 forgot/reset password.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------- Mood ----------

model MoodEntry {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  mood            Mood
  intensity       Int?     @db.SmallInt
  note            String?  @db.VarChar(1000)
  // Client-generated key; the unique pair prevents accidental double submissions.
  clientRequestId String   @map("client_request_id") @db.VarChar(64)
  recordedAt      DateTime @default(now()) @map("recorded_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags MoodTag[]

  @@unique([userId, clientRequestId])
  @@index([userId, recordedAt])
  @@map("mood_entries")
}

model MoodTag {
  id          String @id @default(uuid()) @db.Uuid
  moodEntryId String @map("mood_entry_id") @db.Uuid
  tag         String @db.VarChar(32)

  moodEntry MoodEntry @relation(fields: [moodEntryId], references: [id], onDelete: Cascade)

  @@unique([moodEntryId, tag])
  @@map("mood_tags")
}

// ---------- Assessments ----------

model Assessment {
  id          String         @id @default(uuid()) @db.Uuid
  slug        String         @unique @db.VarChar(64)
  kind        AssessmentKind @unique
  title       String         @db.VarChar(120)
  description String
  isActive    Boolean        @default(true) @map("is_active")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  questions AssessmentQuestion[]
  results   AssessmentResult[]

  @@map("assessments")
}

model AssessmentQuestion {
  id           String @id @default(uuid()) @db.Uuid
  assessmentId String @map("assessment_id") @db.Uuid
  position     Int
  prompt       String
  // Option list stored as JSON: [{ value: 0, label: "..." }, ...]
  options      Json

  assessment Assessment        @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  answers    AssessmentAnswer[]

  @@unique([assessmentId, position])
  @@map("assessment_questions")
}

model AssessmentResult {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  assessmentId String   @map("assessment_id") @db.Uuid
  totalScore   Int      @map("total_score")
  category     String   @db.VarChar(40)
  summary      String
  createdAt    DateTime @default(now()) @map("created_at")

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessment Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  answers    AssessmentAnswer[]

  @@index([userId, assessmentId, createdAt])
  @@map("assessment_results")
}

model AssessmentAnswer {
  id         String @id @default(uuid()) @db.Uuid
  resultId   String @map("result_id") @db.Uuid
  questionId String @map("question_id") @db.Uuid
  value      Int    @db.SmallInt

  result   AssessmentResult   @relation(fields: [resultId], references: [id], onDelete: Cascade)
  question AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([resultId, questionId])
  @@map("assessment_answers")
}

// ---------- Wellness content & activities ----------

model WellnessResource {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique @db.VarChar(64)
  title     String   @db.VarChar(120)
  summary   String
  // Structured sections: [{ heading, body, steps? }]. Content is authored, never generated at runtime.
  sections  Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  savedBy UserSavedResource[]

  @@map("wellness_resources")
}

model WellnessActivity {
  id          String           @id @default(uuid()) @db.Uuid
  slug        String           @unique @db.VarChar(64)
  title       String           @db.VarChar(120)
  description String
  category    ActivityCategory
  durationSec Int              @map("duration_sec")
  xpReward    Int              @default(20) @map("xp_reward")
  steps       Json
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  completions ActivityCompletion[]

  @@index([category])
  @@map("wellness_activities")
}

model ActivityCompletion {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  activityId  String   @map("activity_id") @db.Uuid
  // Local calendar date in the user's timezone; used to prevent duplicate rewards per day.
  completedOn DateTime @map("completed_on") @db.Date
  completedAt DateTime @default(now()) @map("completed_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity WellnessActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([userId, activityId, completedOn])
  @@index([userId, completedAt])
  @@map("activity_completions")
}

model UserSavedResource {
  userId     String   @map("user_id") @db.Uuid
  resourceId String   @map("resource_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource WellnessResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([userId, resourceId])
  @@map("user_saved_resources")
}

// ---------- Affirmations ----------

model Affirmation {
  id        String   @id @default(uuid()) @db.Uuid
  text      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  userAffirmations UserAffirmation[]

  @@map("affirmations")
}

model UserAffirmation {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  affirmationId String   @map("affirmation_id") @db.Uuid
  shownOn       DateTime @map("shown_on") @db.Date
  saved         Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  affirmation Affirmation @relation(fields: [affirmationId], references: [id], onDelete: Cascade)

  @@unique([userId, shownOn])
  @@index([userId, affirmationId])
  @@map("user_affirmations")
}

// ---------- Breathing ----------

model BreathingSession {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  // Client-generated key so a retried submission does not create a duplicate session.
  clientRequestId String @map("client_request_id") @db.VarChar(64)
  patternId   String   @map("pattern_id") @db.VarChar(32)
  // { inhale, hold, exhale, rest } in seconds, as used during the session.
  pattern     Json
  cycles      Int      @db.SmallInt
  durationSec Int      @map("duration_sec")
  completed   Boolean  @default(false)
  completedAt DateTime @default(now()) @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientRequestId])
  @@index([userId, completedAt])
  @@map("breathing_sessions")
}

// ---------- AI companion ----------

model AiConversation {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  title     String    @default("New conversation") @db.VarChar(120)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([userId, updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  role           MessageRole
  content        String      @db.VarChar(4000)
  // Which model produced an ASSISTANT message, for honesty and debugging.
  modelName      String?     @map("model_name") @db.VarChar(64)
  createdAt      DateTime    @default(now()) @map("created_at")
  deletedAt      DateTime?   @map("deleted_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

// Only written when the user has granted AI personalisation consent.
model UserAiMemory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  kind      String   @db.VarChar(32)
  content   String   @db.VarChar(500)
  source    String   @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@map("user_ai_memories")
}

// ---------- Gamification ----------

model XpTransaction {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  amount    Int
  reason    XpReason
  // Deterministic key per rewardable event (e.g. "mood:2026-11-05") so retries never double-award.
  sourceKey String   @map("source_key") @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceKey])
  @@index([userId, createdAt])
  @@map("xp_transactions")
}

model UserLevel {
  userId    String   @id @map("user_id") @db.Uuid
  totalXp   Int      @default(0) @map("total_xp")
  level     Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_levels")
}

model UserStreak {
  userId         String    @id @map("user_id") @db.Uuid
  currentDays    Int       @default(0) @map("current_days")
  longestDays    Int       @default(0) @map("longest_days")
  // Local calendar date of the last counted activity, in the user's timezone.
  lastActiveDate DateTime? @map("last_active_date") @db.Date
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_streaks")
}

// ---------- Notifications ----------

model NotificationPreference {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  enabled   Boolean          @default(false)
  // Local time "HH:mm" in the user's timezone.
  timeOfDay String           @default("09:00") @map("time_of_day") @db.VarChar(5)
  // Bitmask: bit 0 = Monday ... bit 6 = Sunday. 127 = every day.
  daysMask  Int              @default(127) @map("days_mask") @db.SmallInt
  label     String?          @db.VarChar(60)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, label])
  @@map("notification_preferences")
}

model Notification {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  type         NotificationType
  title        String           @db.VarChar(120)
  body         String           @db.VarChar(300)
  // Deep link target inside the app, e.g. "/breathing" or "/mood/new".
  deepLink     String?          @map("deep_link") @db.VarChar(200)
  scheduledFor DateTime         @map("scheduled_for")
  // Prevents the scheduler from sending the same reminder twice on one local day.
  dedupeKey    String?          @unique @map("dedupe_key") @db.VarChar(120)
  sentAt       DateTime?        @map("sent_at")
  readAt       DateTime?        @map("read_at")
  createdAt    DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, scheduledFor])
  @@map("notifications")
}

model PushToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  expoToken  String   @unique @map("expo_token") @db.VarChar(200)
  platform   String   @db.VarChar(16)
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

// ---------- Therapist directory ----------

model TherapistProfile {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @db.VarChar(120)
  specialization String   @db.VarChar(160)
  city           String   @db.VarChar(80)
  region         String   @db.VarChar(80)
  languages      String[]
  // Only true when verified against a real provider source. Seeded sample rows are false.
  isVerified     Boolean  @default(false) @map("is_verified")
  isSample       Boolean  @default(true) @map("is_sample")
  consultation   String   @db.VarChar(200)
  contactUrl     String?  @map("contact_url") @db.VarChar(300)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([city])
  @@map("therapist_profiles")
}
