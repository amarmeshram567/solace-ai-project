{
  "expo": {
    "name": "Solace AI",
    "slug": "solace-ai",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "solace",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF7BC",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#FFF7BC",
      "resizeMode": "contain"
    },
    "ios": {
      "bundleIdentifier": "com.solaceai.app",
      "buildNumber": "1",
      "supportsTablet": false
    },
    "android": {
      "package": "com.solaceai.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFF7BC"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#91D5B5"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Solace uses your location once, only when you tap 'Use my city', to find therapists near you. Your coordinates stay on your phone."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Solace uses your photos only when you choose a profile picture."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4b43d102-e25d-4a20-8f86-7a9c0f303ef3"
      }
    },
    "owner": "amarmeshram",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4b43d102-e25d-4a20-8f86-7a9c0f303ef3"
    }
  }
}
