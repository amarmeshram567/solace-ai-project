# Public values only. Anything prefixed EXPO_PUBLIC_ is bundled into the app.
# Never put secrets, database URLs, JWT secrets, or AI credentials here.

# Android emulator -> host machine:
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api/v1

# Web uses localhost when the URL above points to the Android emulator.
# Set this when the web app needs a different API host.
# EXPO_PUBLIC_API_URL_WEB=http://localhost:4000/api/v1

# Physical device on the same Wi-Fi: replace with your computer's LAN IP, e.g.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:4000/api/v1

# Push reminders: the Expo project ID from your EAS project (public identifier, not a secret).
# Leave empty to keep reminders in the in-app inbox only.
EXPO_PUBLIC_EAS_PROJECT_ID=
